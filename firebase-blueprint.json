{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile authenticated via Firebase",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog product and inventory stock",
      "type": "object",
      "properties": {
        "codigo": { "type": "string" },
        "nombre": { "type": "string" },
        "precio": { "type": "number" },
        "stock": { "type": "number" },
        "reorden": { "type": "number" },
        "categoria": { "type": "string" }
      },
      "required": ["codigo", "nombre", "precio", "stock", "reorden"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase order created by a client or sales agent",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "clienteIdx": { "type": "number" },
        "total": { "type": "number" },
        "estado": { "type": "string", "enum": ["Pendiente", "Listo", "Entregado"] },
        "creado": { "type": "number" }
      },
      "required": ["id", "clienteIdx", "total", "estado", "creado"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Kardex stock adjustment or sales movement",
      "type": "object",
      "properties": {
        "fecha": { "type": "number" },
        "codigo": { "type": "string" },
        "nombre": { "type": "string" },
        "motivo": { "type": "string" },
        "cantidad": { "type": "number" },
        "saldo": { "type": "number" }
      },
      "required": ["fecha", "codigo", "cantidad", "saldo"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for authenticated business accounts"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Wholesale products catalogue and live inventory"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders submitted in store or operations center"
    },
    "/movements/{movementId}": {
      "schema": "InventoryMovement",
      "description": "Warehouse stock transaction logs"
    }
  }
}
